From 6bbe8a08d84ae448b1c09413138ab87a2b5d8104 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 05:04:23 +0000
Subject: [PATCH 2/5] Goals SQL: rebuild empty leftover goals tables, refuse if
 they hold data

---
 supabase-goals.sql | 50 +++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 49 insertions(+), 1 deletion(-)

diff --git a/supabase-goals.sql b/supabase-goals.sql
index 498dc0b..322022f 100644
--- a/supabase-goals.sql
+++ b/supabase-goals.sql
@@ -1,13 +1,61 @@
 -- =========================================================
 -- Ipon — Savings Goals
 -- Run this once in the Supabase SQL editor, AFTER supabase.sql.
--- Safe to re-run: every statement is idempotent.
+-- Safe to re-run. Leftover tables with the wrong layout are rebuilt
+-- only if empty (see Step 0).
 --
 -- Goals are an allocation layer on top of your platform
 -- balances: adding money to a goal does NOT change any
 -- platform balance or create a transaction.
 -- =========================================================
 
+-- ---------------------------------------------------------
+-- Step 0: handle leftover tables
+-- If a goals / goal_contributions table already exists with a
+-- different shape (e.g. from an earlier experiment), "create table
+-- if not exists" would silently keep it and later steps would fail.
+--   * correct shape      -> left alone (script stays re-runnable)
+--   * wrong shape, empty -> dropped and recreated below
+--   * wrong shape, rows  -> script STOPS so no data is lost
+-- ---------------------------------------------------------
+do $$
+declare
+  goals_ok   boolean;
+  contrib_ok boolean;
+  n          bigint;
+begin
+  select count(*) = 9 into goals_ok
+  from information_schema.columns
+  where table_schema = 'public' and table_name = 'goals'
+    and column_name in ('id','user_id','name','description','target_amount',
+                        'target_date','status','completed_at','created_at');
+
+  select count(*) = 7 into contrib_ok
+  from information_schema.columns
+  where table_schema = 'public' and table_name = 'goal_contributions'
+    and column_name in ('id','user_id','goal_id','amount','date','note','created_at');
+
+  if to_regclass('public.goals') is not null and not goals_ok then
+    execute 'select count(*) from public.goals' into n;
+    if n > 0 then
+      raise exception 'public.goals already exists with a different layout and holds % row(s). Not dropping it. Rename it or migrate it first.', n;
+    end if;
+    drop view if exists public.goal_progress;
+    drop table if exists public.goal_contributions;
+    drop table public.goals;
+    contrib_ok := false;
+  end if;
+
+  if to_regclass('public.goal_contributions') is not null and not contrib_ok then
+    execute 'select count(*) from public.goal_contributions' into n;
+    if n > 0 then
+      raise exception 'public.goal_contributions already exists with a different layout and holds % row(s). Not dropping it. Rename it or migrate it first.', n;
+    end if;
+    drop view if exists public.goal_progress;
+    drop table public.goal_contributions;
+  end if;
+end $$;
+
 -- ---------------------------------------------------------
 -- Tables
 -- ---------------------------------------------------------
-- 
